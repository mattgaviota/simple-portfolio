NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google account allowed to access /admin (must match the email in firestore.rules and storage.rules)
NEXT_PUBLIC_ADMIN_EMAIL=
# Country shipping is limited to; shown in the cart and the confirmation email. Leave empty to hide the notice
NEXT_PUBLIC_SHIPPING_COUNTRY=

# Mercado Pago (server only, never prefix with NEXT_PUBLIC_)
MP_ACCESS_TOKEN=
# Signature secret of the webhook (Webhooks > Clave secreta). Optional: if empty the signature is not
# checked, which is still safe because every payment is re-fetched from Mercado Pago
MP_WEBHOOK_SECRET=
# Public base URL of the site, e.g. https://example.com (a tunnel URL in development)
APP_URL=
# Hours the Mercado Pago payment link stays valid after checkout (default 24, 0 = never expires)
CHECKOUT_EXPIRATION_HOURS=
# Resend, used for the order confirmation email
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Mi Tienda <pedidos@example.com>
EMAIL_FROM=
# Where buyers' replies go (the shipping address they send back). Optional but recommended
EMAIL_REPLY_TO=
# Firebase service account JSON on a single line
FIREBASE_SERVICE_ACCOUNT=
