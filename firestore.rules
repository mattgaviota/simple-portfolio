rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL';
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }

    // Orders are created and paid-status updated only by the server (the Admin
    // SDK bypasses rules). The admin may only mark shipping; cancelling goes
    // through the server, and orders are never deleted.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['shippedAt', 'updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0;
      allow delete: if isAdmin();
    }
  }
}
